{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "jsx": "react-jsx",
  "strict": true,
  "noImplicitAny": false,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "resolveJsonModule": true,
  "types": [
   "node"
  ],
  "noEmit": true,
  "lib": [
   "ES2022",
   "DOM",
   "DOM.Iterable"
  ],
  "paths": {
   "@/*": [
    "./src/ui/*"
   ]
  }
 },
 "include": [
  "src",
  "electron",
  "tests",
  "scripts"
 ]
}