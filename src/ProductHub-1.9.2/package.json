{
  "name": "product-hub",
  "version": "1.9.2",
  "description": "统一产品库 - 跨端产品情报桌面应用",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"vite\"",
    "dev:server": "tsx src/server/main.ts --port 8787",
    "build": "tsc -p . && vite build && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "preview": "node dist-server/server.js --readonly --port 8788",
    "serve": "node dist-server/server.js --port 8787",
    "seed": "tsx scripts/build-seed.ts 240 --fresh && python3 scripts/compress-images.py",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:linux": "npm run build && npm run pack:seed && electron-builder --linux AppImage tar.gz --x64",
    "dist:win": "npm run build && npm run pack:seed && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run build && npm run pack:seed && electron-builder --mac dmg zip --x64 --arm64",
    "pack:seed": "npm run prep:seed && SEED_DB=build/seed-tmp/producthub.db python3 scripts/pack-seed.py",
    "app": "npm run build && electron .",
    "prep:seed": "npx tsx scripts/prep-seed.ts",
    "pack:delta": "tsx scripts/pack-delta.ts"
  },
  "keywords": [],
  "author": "GAOSICHUN",
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-checkbox": "^1.4.0",
    "@radix-ui/react-collapsible": "^1.2.0",
    "@radix-ui/react-context-menu": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.6",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^1.55.0",
    "node-html-parser": "^9.0.4",
    "papaparse": "^5.7.0",
    "pinyin-pro": "^3.29.5",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socks-proxy-agent": "^8.0.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "xlsx": "^0.18.5"
  },
  "productName": "统一产品库",
  "build": {
    "appId": "com.gaosichun.producthub",
    "productName": "统一产品库",
    "artifactName": "ProductHub-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist-server/**",
      "dist-ui/**",
      "data/sources.csv",
      "package.json",
      "!node_modules/better-sqlite3/{src,deps,docs,benchmark}/**",
      "!node_modules/better-sqlite3/build/{Debug,deps,test_extension}/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "**/*.node",
      "dist-electron/delta-worker.js",
      "dist-server/delta-worker.js"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ProductHub-Setup-${version}-win-${arch}.${ext}",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "统一产品库",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "allowElevation": true,
      "unicode": true
    },
    "portable": {
      "artifactName": "ProductHub-${version}-win-${arch}-portable.${ext}"
    },
    "extraResources": [
      {
        "from": "build/seed-pack",
        "to": "seed"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "forceCodeSigning": false,
    "npmRebuild": false,
    "afterPack": "./scripts/after-pack-icon.mjs"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@33.4.11": true,
    "esbuild@0.28.2": true
  }
}
